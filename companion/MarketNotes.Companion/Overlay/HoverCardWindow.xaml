<Window x:Class="MarketNotes.Companion.Overlay.HoverCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item notes"
        Width="280"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13">
    <Border Background="#F2F7F1E4"
            BorderBrush="#C4A15A"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <StackPanel>
            <TextBlock x:Name="ItemTitle"
                       FontFamily="Georgia"
                       FontSize="16"
                       Foreground="#5C241C"
                       TextWrapping="Wrap" />
            <StackPanel x:Name="SectionsHost" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
